<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Blueprint</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../part-support.json" LogicalName="PawPrints.PartSupport.json" />
    <None Include="../part-support.json" Link="part-support.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="../assets/fonts/mrdafoe/MrDafoe-Regular.ttf" LogicalName="PawPrints.Fonts.mrdafoe.ttf" />
    <EmbeddedResource Include="../assets/fonts/kristi/Kristi-Regular.ttf" LogicalName="PawPrints.Fonts.kristi.ttf" />
    <EmbeddedResource Include="../assets/fonts/reeniebeanie/ReenieBeanie.ttf" LogicalName="PawPrints.Fonts.reeniebeanie.ttf" />
    <EmbeddedResource Include="../assets/fonts/nothingyoucoulddo/NothingYouCouldDo.ttf" LogicalName="PawPrints.Fonts.nothingyoucoulddo.ttf" />
    <EmbeddedResource Include="../assets/fonts/zeyada/Zeyada.ttf" LogicalName="PawPrints.Fonts.zeyada.ttf" />
    <EmbeddedResource Include="../assets/fonts/labelleaurore/LaBelleAurore.ttf" LogicalName="PawPrints.Fonts.labelleaurore.ttf" />
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <Reference Include="$(GameDir)/KSA.dll" Private="false" />
    <Reference Include="$(GameDir)/BepuUtilities.dll" Private="false" />
    <Reference Include="$(GameDir)/Brutal.*.dll" Private="false" />
    <Reference Include="$(GameDir)/Planet.*.dll" Private="false" />
    <Reference Include="$(LoaderDir)/StarMap.API.dll" Private="false" />
    <Reference Include="$(LoaderDir)/0Harmony.dll" Private="false" />
  </ItemGroup>
  <Import Project="../build/PortableRendering.props" Condition="'$(PawPrintsPortableRendering)' == 'true'" />
</Project>
