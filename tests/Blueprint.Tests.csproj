    <EmbeddedResource Include="../assets/fonts/zeyada/Zeyada.ttf" LogicalName="PawPrints.Fonts.zeyada.ttf" />
    <EmbeddedResource Include="../assets/fonts/labelleaurore/LaBelleAurore.ttf" LogicalName="PawPrints.Fonts.labelleaurore.ttf" />

    <Compile Include="Program.cs" />
    <Compile Include="../src/CaptureStats.cs" />
