<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- Standalone local probe: these game references stay in ignored test output. -->
  <ItemGroup>
    <Reference Include="$(GameDir)/Brutal.ImGui.dll" Private="true" />
    <Reference Include="$(GameDir)/Brutal.ImGui.Abstractions.dll" Private="true" />
    <Reference Include="$(GameDir)/Brutal.Numerics.dll" Private="true" />
    <Reference Include="$(GameDir)/Brutal.Core.dll" Private="true" />
    <Compile Include="../../src/PrintUiText.cs" Link="PrintUiText.cs" />
    <Compile Include="../../src/PrintWorkspaceFocus.cs" Link="PrintWorkspaceFocus.cs" />
    <Compile Include="../../src/PrintDiagnostics.cs" Link="PrintDiagnostics.cs" />
  </ItemGroup>
</Project>
